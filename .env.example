# Bu dosyayı `.env` olarak kopyala ve kendi değerlerinle doldur:
#   cp .env.example .env
# Gerçek .env dosyası ASLA git'e / paylaşıma girmez (.gitignore'da).

# NVD API anahtarı (opsiyonel ama önerilir).
# Anahtarsız: 30 saniyede 5 istek. Anahtarlı: 30 saniyede 50 istek.
# Ücretsiz al: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Veritabanı konumu (SQLite dosyası)
DATABASE_URL=sqlite:///scry.db

# Flask ayarları
FLASK_SECRET_KEY=degistir-beni-rastgele-bir-deger

# Nuclei aktif doğrulama (versiyon-çıkarımlı CVE'leri hedefte kanıtlamaya çalışır).
# Aktif prob gönderir — müdahalecidir; yalnızca yetkili hedeflerde çalışır.
# nuclei kurulu değilse zaten sessizce atlanır. Kapatmak için: false
NUCLEI_VERIFY=true
NUCLEI_TIMEOUT=180

# CISA KEV + EPSS zenginleştirme (ücretsiz, anahtarsız). Kapatmak için: false
ENRICH=true

# --- Uyarılar (opsiyonel) — boş bırakırsan hiçbir şey gönderilmez ---
# Yeni bir kritik/KEV açık çıkınca haber verir.
# Slack/Discord Incoming Webhook URL'i:
ALERT_WEBHOOK_URL=
# E-posta (SMTP) — hepsini doldurursan e-posta da gönderilir:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
